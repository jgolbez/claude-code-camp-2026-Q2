# Windows Zone.Identifier files (WSL download metadata)
*Zone.Identifier

# Environment / secrets
.env
.env.local

# Boukensha runtime session logs (play-test transcripts, not source)
.boukensha/sessions/*
!.boukensha/sessions/.keep

# Boukensha runtime world-model memory (rebuilt as the agent explores, not source)
.boukensha/world.json

# Boukensha runtime plan state (written by the orchestrator per goal, not source)
.boukensha/plan.json

# Same runtime state for any OTHER character's config dir (characters/<name>/.boukensha),
# and for stray nested dirs left by scripts run in the wrong cwd.
**/.boukensha/world.json
**/.boukensha/plan.json
**/.boukensha/sessions/*
!**/.boukensha/sessions/.keep
