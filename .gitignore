*Zone.Identifier

# Environment / secrets
.env
.env.local

# Boukensha runtime session logs (play-test transcripts, not source)
.boukensha/sessions/*
!.boukensha/sessions/.keep

# Boukensha runtime world-model memory (rebuilt as the agent explores, not source)
.boukensha/world.json
